---
# EXAMPLE VALUES ONLY. Replace every value before use.
# Encrypt the real vault.yml with Ansible Vault; never commit the encrypted file's password.
# Usage: ansible-vault encrypt ansible/group_vars/all/vault.yml

vault_proxmox_api_token: "REPLACE_WITH_PROXMOX_API_TOKEN"
vault_vaultwarden_admin_token: "REPLACE_WITH_VAULTWARDEN_ADMIN_TOKEN"
vault_nextcloud_admin_password: "REPLACE_WITH_NEXTCLOUD_PASSWORD"
vault_postgres_root_password: "REPLACE_WITH_DATABASE_PASSWORD"
vault_tailscale_auth_key: "REPLACE_WITH_TAILSCALE_AUTH_KEY"
vault_telegram_bot_token: "REPLACE_WITH_TELEGRAM_BOT_TOKEN"
vault_telegram_chat_id: "REPLACE_WITH_TELEGRAM_CHAT_ID"
vault_abuseipdb_api_key: "REPLACE_WITH_ABUSEIPDB_API_KEY"
